# Copy to deployment/deploy.env (gitignored) and fill in. No secrets here: SSH_KEY is a
# path to a key that stays on your PC; nothing reads or copies the key itself.

# --- the server (Vast.ai shows "ssh -p PORT root@HOST" on the instance card) ---
REMOTE_HOST=REPLACE_WITH_HOST          # e.g. ssh4.vast.ai, or an IP
REMOTE_PORT=22                         # Vast: the mapped SSH port from the instance card
REMOTE_USER=root
REMOTE_DIR=/workspace/SMB_Flywire_Speedrun
SSH_KEY=                               # e.g. ~/.ssh/id_ed25519 (empty: your ssh default)
SSH_EXTRA=                             # extra ssh options, e.g. -o StrictHostKeyChecking=accept-new

# --- your PC ---
LOCAL_ROM="roms/Super Mario Bros. (World).nes"   # your own ROM; sent alone by push-rom
PULL_DIR=artifacts/remote                        # results come home under PULL_DIR/<host>/

# --- what push sends (sets of deployment/manifest/data_manifest.json) ---
# core            graph + lateral nulls (required)       reference   metric tables, harness v2 files (required)
# rocm-reference  ROCm checkpoints/results for checks    nulls-primary  depth-stratified nulls (null:<s> runs)
# rocm-stageD     ROCm Stage D checkpoints (evaluations only)
TRANSFER_SETS=core,reference,rocm-reference

# --- PyTorch on the server (the reference is 2.9.1; auto picks cu128 for drivers >= 570, else cu126) ---
TORCH_VERSION=2.9.1
TORCH_CUDA=auto

# --- runs ---
MAX_HOURS=8              # each run is asked to stop (and save) after this many hours
MAX_PARALLEL_GPU=1       # raise only after `flydeploy bench` and a measured second run
